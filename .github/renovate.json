{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    ":separateMajorReleases",
    "security:openssf-scorecard"
  ],
  "enabled": true,
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "addLabels": ["dependencies"],
  "reviewers": ["marcschaeferger"],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 6,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update digest-only Go builder image using Alpine tag metadata comments",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^Dockerfile\\.scratch$/"
      ],
      "matchStrings": [
        "FROM\\s+--platform=\\$BUILDPLATFORM\\s+golang@(?<currentDigest>sha256:[a-f0-9]{64})\\s+AS\\s+build\\s*\\n#\\s*renovate:\\s*datasource=docker\\s+depName=golang\\s+versioning=docker\\s*\\n#\\s*renovate-version:\\s*(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "FROM --platform=$BUILDPLATFORM golang@{{#if newDigest}}{{{newDigest}}}{{else}}{{{currentDigest}}}{{/if}} AS build\n# renovate: datasource=docker depName=golang versioning=docker\n# renovate-version: {{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Add OpenSSF Scorecard badge to PR tables",
      "matchSourceUrls": ["https://github.com/**"],
      "prBodyDefinitions": {
        "OpenSSF": "[![OpenSSF Scorecard](https://api.securityscorecards.dev/projects/github.com/{{sourceRepo}}/badge)](https://securityscorecards.dev/viewer/?uri=github.com/{{sourceRepo}})"
      },
      "prBodyColumns": ["Package", "Type", "Update", "Change", "Pending", "OpenSSF"]
    },
    {
      "description": "Group all Go module updates into a single PR; add golang label; tidy modules and update import paths",
      "matchManagers": ["gomod"],
      "groupName": "golang",
      "addLabels": ["golang"],
      "separateMinorPatch": false,
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"]
    },
    {
      "description": "Disable built-in Dockerfile updates for golang because digest-only builder image is managed by custom regex comments",
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "matchFileNames": ["Dockerfile", "Dockerfile.scratch"],
      "enabled": false
    },
    {
      "description": "Keep Go builder image updates on Go 1.x Alpine patch tags only",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "matchFileNames": ["Dockerfile", "Dockerfile.scratch"],
      "allowedVersions": "/^1\\.[0-9]+\\.[0-9]+-alpine$/",
      "groupName": "docker",
      "addLabels": ["docker"],
      "separateMinorPatch": false,
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "pinDigests": true
    },
    {
      "description": "Group all Dockerfile image updates into a single PR; add docker label; pin digests",
      "matchManagers": ["dockerfile"],
      "groupName": "docker",
      "addLabels": ["docker"],
      "separateMinorPatch": false,
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "pinDigests": true
    },
    {
      "description": "Group all GitHub Actions updates into a single PR; add github-actions label; pin by commit SHA",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "addLabels": ["github-actions"],
      "separateMinorPatch": false,
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    }
  ]
}
